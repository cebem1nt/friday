#!/bin/bash
set -o pipefail

cd -- "$(dirname -- "$(realpath -- "$0")")"

if ! ollama list >/dev/null 2>&1; then
    echo "Ollama is not running" >&2
    exit 1
fi

if [[ ! -d ".venv" ]]; then
    echo "Create virtual envrionment first" >&2
    exit 1
fi

# Fix faster whisper cuda support with cuda > 12.0

site="$(.venv/bin/python -c 'import site; print(site.getsitepackages()[0])')"

export LD_LIBRARY_PATH="$site/nvidia/cublas/lib:$site/nvidia/cudnn/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export FRIDAY_ICON_DIR="$PWD/assets/icons/"

set -a
. "$HOME/.config/user-dirs.dirs"

if [[ -e "$HOME/.config/friday/.env" ]]; then
    source "$HOME/.config/friday/.env" # you might put OLLAMA_API_KEY there
fi

set +a

source .venv/bin/activate
"$SHELL" -lic "./friday --serve --log-level=4"