#!/usr/bin/env python3
import argparse, sys

from src import log

if __name__ == "__main__": 
    p = argparse.ArgumentParser(description="Friday is a fully local linux AI assistant. Run without arguments to start an interactive chat.")

    subparsers = p.add_subparsers(dest="command", help="available commands")

    serve_p = subparsers.add_parser("serve", help="start friday IPC server")
    serve_p.add_argument("-l", "--log-level", type=int, default=2, help="log verbosity from 0 (least output) to 4 (most output). Examples: 4 - includes debug, info, warnings, and errors, 2 - includes warnings and errors.")
    serve_p.add_argument("-f", "--log-file", help="duplicate logs to this file")

    p.add_argument("-a", "--ask",      help="ask friday given content (pass as single argument)")
    p.add_argument("-I", "--image",    nargs='+',  help="attach these image[s]. use with --ask")
    p.add_argument("-A", "--audio",    nargs='+',  help="attach audio. use with --ask")
    p.add_argument("-c", "--converse", action="store_true", help="start recording audio, when run once more - stop recording and get response from friday")
    p.add_argument("-w", "--wipe",     action="store_true", help="wipe current friday context")
    p.add_argument("-r", "--reload",   action="store_true", help="reload running friday server (reloads config, restarts everything)")
    p.add_argument("-s", "--say",      help="make friday say given text")

    args = p.parse_args()

    if args.command == "serve":
        from src.ipc.server import serve
        log.set_log_level(args.log_level)
        log.set_log_file(args.log_file)
        serve()
        exit(0)

    from src.ipc.client import FridayClient
    client = FridayClient()

    if args.wipe:
        client.wipe_context()
        
    if args.reload:
        from src.shared import friday_server_reload
        friday_server_reload()

    if args.say:
        client.say(args.say)

    if args.converse:
        client.converse(False)
    elif args.ask:
        print(client.reply(
            args.ask, images=args.image, audio=args.audio, stream=False))
    elif len(sys.argv) == 1:
        from src.cli import CLI

        cli = CLI(client)
        cli.chat()