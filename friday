#!/usr/bin/env python3
import argparse

from src import log

if __name__ == "__main__": 
    p = argparse.ArgumentParser(description="Friday is a fully local linux AI assistant. Run without arguments to start an interactive chat.")

    subparsers = p.add_subparsers(dest="command", help="available commands")

    serve_p = subparsers.add_parser("serve", help="start friday IPC server")
    serve_p.add_argument("-l", "--log-level", type=int, default=2, 
        help="log verbosity from 0 (least output) to 4 (most output). Examples: 4 - includes debug, info, warnings, and errors, 2 - includes warnings and errors.")

    p.add_argument("-c", "--converse",    action="store_true", help="start recording audio, when run once more - stop recording and get response from friday")
    p.add_argument("-w", "--wipe",        action="store_true", help="wipe current friday context")
    p.add_argument("-a", "--ask",         help="ask friday given content (pass as single argument)")
    p.add_argument("--image", nargs='+',  help="attach these image[s]. use with --ask")
    p.add_argument("--audio", nargs='+',  help="attach audio. use with --ask")

    args = p.parse_args()

    if args.command == "serve":
        from src.ipc.server import friday_serve
        log.set_log_level(args.log_level)
        friday_serve()
        exit(0)

    from src.ipc.client import FridayClient
    client = FridayClient()

    if args.wipe:
        print(client.wipe_context())

    if args.converse:
        client.converse(False)
    elif args.ask:
        print(client.reply(
            args.ask, images=args.image, audio=args.audio, stream=False))
    else:
        from src.cli import CLI

        cli = CLI(client)
        cli.chat()